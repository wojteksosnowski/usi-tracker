{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "usi_meta.schema.json",
  "title": "USI Investment Meta Data (Level 2m)",
  "description": "User-added metadata, ratings, and overrides for a specific investment portal record.",
  "type": "object",
  "properties": {
    "status": { 
      "type": "string", 
      "enum": ["Brak", "AI", "Wstępna", "Poszerzona", "Pełna", "Aktualizacja", "Ukończona"],
      "default": "Brak"
    },
    "reviewed": { "type": "boolean", "default": false },
    "issue_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note", "at"],
        "properties": {
          "note": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "website": { "type": ["string", "null"] },
    "location_override": {
      "type": "object",
      "properties": {
        "coords": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" }
      }
    },
    "ratings": {
      "type": "object",
      "properties": {
        "Balkony": { "type": ["number", "null"] },
        "Fasady": { "type": ["number", "null"] },
        "Wnętrza": { "type": ["number", "null"] },
        "Teren": { "type": ["number", "null"] },
        "Mieszkania": { "type": ["number", "null"] },
        "Udogodnienia": { "type": ["number", "null"] },
        "komentarz": { "type": ["string", "null"] },
        "imgList": { "type": ["string", "null"] }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "updated_at": { "type": "string", "format": "date-time" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "event"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "event": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
